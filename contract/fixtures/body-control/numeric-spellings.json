      "why": "the plain spelling every reader has always taken",
      "direction": "request",
      "field": "protocol",
      "line": "{\"op\":\"handshake\",\"protocol\":4,\"requestId\":\"req-1\",\"agentId\":\"agent-alpha\"}",
      "accepted": true,
      "value": 4
