{
  "name": "loom-research",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned Loom experiment manifests, bounded shared-world runner, evidence normalizer, deterministic metrics, and publication validator.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "coverage": "c8 node --test \"test/*.test.js\"",
    "lint": "standard",
    "format": "standard --fix",
    "check": "npm run lint && npm test",
    "tribe": "node --max-old-space-size=12288 bin/loom-tribe.js"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "standard": "17.1.2"
  },
  "standard": {
    "env": [
      "node"
    ]
  }
}
