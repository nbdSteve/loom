# Kotlin / JVM / Gradle (plugin/)
.gradle/
build/
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
.kotlin/

# Rust (cognition/)
target/
**/*.rs.bk
Cargo.lock

# Node (body/). The lockfile is deliberately NOT ignored: the body package pins
# its dependencies exactly, and the lockfile is what makes a checkout resolve the
# same tree the gate was run against.
node_modules/

# IDEs / editors
.idea/
*.iml
.vscode/
*.swp

# OS
.DS_Store

# Local environment / secrets
.env
*.local

# Minecraft server runtime artifacts. A local test server is scratch: it holds a
# server jar, generated worlds, and the plugin's own event log, none of which
# belong to the repository.
server/
server-arena/
world/
world_nether/
world_the_end/
logs/
*.log
